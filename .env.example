# The reproducible baseline does not require an LLM API key.
JINRONG_PARSER_PROFILE=portable
# Required only when JINRONG_PARSER_PROFILE=libreoffice.
JINRONG_LIBREOFFICE_EXECUTABLE=
JINRONG_LIBREOFFICE_VERSION=
JINRONG_LLM_API_KEY=
JINRONG_LLM_BASE_URL=https://api.openai.com/v1
JINRONG_LLM_MODEL=gpt-4o-mini
JINRONG_LLM_TIMEOUT=30
